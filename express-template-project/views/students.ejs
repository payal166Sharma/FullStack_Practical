<!DOCTYPE html>
<html>
<head>
    <title>Students</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="container">

        <h1>Student List</h1>

        <table>

            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Course</th>
            </tr>

            <% students.forEach(function(student) { %>

                <tr>
                    <td><%= student.id %></td>
                    <td><%= student.name %></td>
                    <td><%= student.course %></td>
                </tr>

            <% }); %>

        </table>

        <br>

        <a href="/">Home</a>

        <a href="/add-student">Add Student</a>

    </div>

</body>
</html>